{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "ThreatSyft: MCP enrichment server",
            "type": "debugpy",
            "request": "launch",
            "module": "threatsyft.mcp.enrichment_server",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "ThreatSyft: MCP knowledge server",
            "type": "debugpy",
            "request": "launch",
            "module": "threatsyft.mcp.knowledge_server",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "ThreatSyft: update snapshots",
            "type": "debugpy",
            "request": "launch",
            "module": "threatsyft.update_cli",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "all"
            ]
        }
    ]
}
