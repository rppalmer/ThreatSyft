{
    "servers": {
        "threatsyft-enrichment": {
            "type": "stdio",
            "command": "${command:python.interpreterPath}",
            "cwd": "${workspaceFolder}",
            "args": [
                "-m",
                "threatsyft.mcp.enrichment_server"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "dev": {
                "watch": "src/**/*.py",
                "debug": {
                    "type": "debugpy"
                }
            }
        },
        "threatsyft-knowledge": {
            "type": "stdio",
            "command": "${command:python.interpreterPath}",
            "cwd": "${workspaceFolder}",
            "args": [
                "-m",
                "threatsyft.mcp.knowledge_server"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "dev": {
                "watch": "src/**/*.py",
                "debug": {
                    "type": "debugpy"
                }
            }
        }
    }
}
