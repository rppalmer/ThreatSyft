{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install/update dependencies",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "pip",
                "install",
                "-r",
                "requirements-dev.txt"
            ],
            "problemMatcher": []
        },
        {
            "label": "Ruff: check",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/ruff",
            "args": [
                "check",
                "."
            ],
            "problemMatcher": []
        },
        {
            "label": "Ruff: format check",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/ruff",
            "args": [
                "format",
                "--check",
                "."
            ],
            "problemMatcher": []
        },
        {
            "label": "Pytest",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "pytest"
            ],
            "problemMatcher": []
        },
        {
            "label": "ThreatSyft: Update knowledge snapshots",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "threatsyft.update_cli",
                "all"
            ],
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src"
                }
            },
            "problemMatcher": []
        }
    ]
}
