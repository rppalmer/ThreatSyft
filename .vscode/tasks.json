{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install/update dependencies",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "pip",
                "install",
                "-r",
                "requirements-dev.txt"
            ],
            "problemMatcher": []
        },
        {
            "label": "Ruff: check",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/ruff",
            "args": [
                "check",
                "."
            ],
            "problemMatcher": []
        },
        {
            "label": "Ruff: format check",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/ruff",
            "args": [
                "format",
                "--check",
                "."
            ],
            "problemMatcher": []
        },
        {
            "label": "Pytest",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "pytest"
            ],
            "problemMatcher": []
        },
        {
            "label": "ThreatSyft: CLI domain example.com",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "main.py",
                "--compact",
                "domain",
                "example.com"
            ],
            "problemMatcher": []
        },
        {
            "label": "ThreatSyft: CLI help",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "main.py",
                "--help"
            ],
            "problemMatcher": []
        },
        {
            "label": "ThreatSyft: CLI doctor",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "main.py",
                "--compact",
                "doctor"
            ],
            "problemMatcher": []
        },
        {
            "label": "ThreatSyft: CLI tools",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "main.py",
                "--compact",
                "tools"
            ],
            "problemMatcher": []
        },
        {
            "label": "ThreatSyft: CLI smoke safe samples",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "main.py",
                "--compact",
                "smoke"
            ],
            "problemMatcher": []
        },
        {
            "label": "ThreatSyft: Knowledge status",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "main.py",
                "--compact",
                "knowledge-status"
            ],
            "problemMatcher": []
        },
        {
            "label": "ThreatSyft: Knowledge update all",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "main.py",
                "knowledge-update",
                "all"
            ],
            "problemMatcher": []
        }
    ]
}
