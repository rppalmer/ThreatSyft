ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
SENTINEL_API_KEY=
CENSYS_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ALIENVAULT_API_KEY=
GOOGLE_SAFEBROWSING_API_KEY=
SECURITYTRAILS_API_KEY=
NVD_API_KEY=
# Optional. urlscan.io search works unauthenticated; a key raises the quota.
URLSCAN_API_KEY=
HYBRID_ANALYSIS_API_KEY=
# Download credentials for `threatsyft-update maxmind`, not lookup-time keys.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Future provider keys

# ---------------------------------------------------------------------------
# Optional overrides. The value shown after each name is the built-in default,
# so this section is documentation, not configuration.
#
# Leave these commented out unless you are changing one. An assignment with an
# empty value (THREATSYFT_CISA_KEV_URL=) is NOT the same as leaving it unset:
# it overrides the default with an empty string, which breaks the setting.
# ---------------------------------------------------------------------------

# THREATSYFT_TIMEOUT_SECONDS=15
# THREATSYFT_ATTACK_STIX_PATH=~/.threatsyft/knowledge/attack/enterprise-attack.json
# THREATSYFT_ATTACK_STIX_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json
# THREATSYFT_CISA_KEV_PATH=~/.threatsyft/knowledge/cisa/known_exploited_vulnerabilities.json
# THREATSYFT_CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# THREATSYFT_LOLBAS_PATH=~/.threatsyft/knowledge/lolbas/lolbas.json
# THREATSYFT_LOLBAS_URL=https://lolbas-project.github.io/api/lolbas.json
# THREATSYFT_NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# THREATSYFT_RDAP_BASE_URL=https://rdap.org
# THREATSYFT_ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2
# THREATSYFT_GREYNOISE_BASE_URL=https://api.greynoise.io/v3/community
# THREATSYFT_SENTINEL_BASE_URL=https://maskbreak.com/v1
# THREATSYFT_CENSYS_BASE_URL=https://api.platform.censys.io/v3
# THREATSYFT_VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
# THREATSYFT_SHODAN_BASE_URL=https://api.shodan.io
# THREATSYFT_SECURITYTRAILS_BASE_URL=https://api.securitytrails.com/v1
# THREATSYFT_ALIENVAULT_BASE_URL=https://otx.alienvault.com/api/v1
# THREATSYFT_GOOGLE_SAFEBROWSING_BASE_URL=https://safebrowsing.googleapis.com
# THREATSYFT_URLSCAN_BASE_URL=https://urlscan.io/api/v1
# THREATSYFT_HYBRID_ANALYSIS_BASE_URL=https://www.hybrid-analysis.com/api/v2
# THREATSYFT_MAXMIND_BASE_URL=https://download.maxmind.com/geoip/databases
# THREATSYFT_MAXMIND_CITY_PATH=~/.threatsyft/knowledge/maxmind/GeoLite2-City.mmdb
# THREATSYFT_MAXMIND_ASN_PATH=~/.threatsyft/knowledge/maxmind/GeoLite2-ASN.mmdb
